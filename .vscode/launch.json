{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Program",
            "program": "${file}",
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "name": "copyFile(Windows)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "cmd",
            "runtimeArgs": ["/c", "copy", "/Y", "${file}", "F:\\data\\usr\\tmp\\"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "name": "copyFile(Linux)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "bash",
            "runtimeArgs": ["-c", "cp -f ${file} /lamda/data/usr/tmp/"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}